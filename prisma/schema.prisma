// Prisma Schema configuration for EduInsight
// Unified Database: MySQL (XAMPP) - eduinsight_db

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 1. Entity User (Mahasiswa, Dosen, Admin)
model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  alternativeEmails  String?  @db.Text
  password           String
  role               String   @default("mahasiswa")
  nim                String?
  nip                String?  @unique
  angkatan           String?  @default("2023")
  fakultas           String?  @default("Ilmu Komputer")
  prodi              String?  @default("Teknik Informatika")
  mataKuliah         String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  kelasDiajar        Kelas[]            @relation("DosenKelas")
  notes              Note[]
  pengumpulanTugas   PengumpulanTugas[]
  passwordSettings   PasswordSetting[]

  @@map("users")
}

// 2. Entity MataKuliah (Master Data Matkul)
model MataKuliah {
  id        String   @id @default(uuid())
  kode      String   @unique
  nama      String
  sks       Int      @default(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  daftarKelas Kelas[]

  @@map("mata_kuliah")
}

// 3. Entity Kelas (Kelas Perkuliahan & Jadwal di Semester)
model Kelas {
  id          String   @id @default(uuid())
  kodeGabung  String   @unique
  ruangan     String
  hari        String
  jamMulai    String
  jamSelesai  String
  semester    Int      @default(6)
  tahunAjaran String   @default("2025/2026 Genap")
  status      String   @default("Aktif")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mataKuliahId String
  mataKuliah   MataKuliah @relation(fields: [mataKuliahId], references: [id], onDelete: Cascade)

  dosenId String
  dosen   User   @relation("DosenKelas", fields: [dosenId], references: [id])

  daftarTugas Tugas[]
  kehadiran   Kehadiran[]
  penilaian   Penilaian[]
  evaluasi    Evaluasi[]

  @@map("kelas")
}

// 4. Entity Tugas (Tugas Perkuliahan)
model Tugas {
  id           String   @id @default(uuid())
  judul        String
  deskripsi    String?  @db.Text
  deadline     DateTime
  deadlineText String?  @default("Hari ini, 23.59")
  category     String   @default("segera") // segera, selesai, terlambat
  lampiran     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  kelasId String
  kelas   Kelas  @relation(fields: [kelasId], references: [id], onDelete: Cascade)

  pengumpulan PengumpulanTugas[]

  @@map("tugas")
}

// 5. Entity PengumpulanTugas (Submissions Mahasiswa)
model PengumpulanTugas {
  id          String   @id @default(uuid())
  taskId      String
  studentId   String
  fileName    String?
  status      String   @default("Diserahkan")
  submittedAt DateTime @default(now())

  tugas Tugas @relation(fields: [taskId], references: [id], onDelete: Cascade)
  siswa User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("pengumpulan_tugas")
}

// 6. Entity Kehadiran (Presensi Perkuliahan)
model Kehadiran {
  id          String   @id @default(uuid())
  kelasId     String
  namaMatkul  String?
  studentName String?
  nomor       Int      @default(1)
  topik       String
  tanggal     String
  status      String   @default("Hadir") // Hadir, Sakit, Izin, Alfa
  createdAt   DateTime @default(now())

  kelas Kelas @relation(fields: [kelasId], references: [id], onDelete: Cascade)

  @@map("kehadiran")
}

// 7. Entity Penilaian (Penilaian Tugas & Mata Kuliah untuk Web & Mobile)
model Penilaian {
  id          String   @id @default(uuid())
  kelasId     String
  studentName String
  taskName    String
  score       Int      @default(0)
  createdAt   DateTime @default(now())

  kelas Kelas @relation(fields: [kelasId], references: [id], onDelete: Cascade)

  @@map("penilaian")
}

// 8. Entity Evaluasi (Evaluasi Mahasiswa & AI Feedback)
model Evaluasi {
  id               String   @id @default(uuid())
  kelasId          String?
  studentName      String?
  nilaiAkhir       Float?
  trenKehadiran    String?
  indikatorRisiko  String?
  insightPerforma  String?  @db.Text
  catatanDosen     String?  @db.Text
  dateText         String?
  lecturerName     String?
  messages         String?  @db.Text
  lecturerNote     String?  @db.Text
  createdAt        DateTime @default(now())

  kelas Kelas? @relation(fields: [kelasId], references: [id], onDelete: SetNull)

  @@map("evaluasi_mahasiswa")
}

// 9. Entity PasswordSetting (Pengaturan Sandi & Notifikasi Dosen dari Web)
model PasswordSetting {
  id               Int      @id @default(autoincrement())
  dosenId          String
  passwordHash     String
  notifikasiEmail   Boolean  @default(true)
  notifikasiSistem  Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  dosen User @relation(fields: [dosenId], references: [id], onDelete: Cascade)

  @@map("password_setting")
}

// 10. Entity Note (Catatan Mahasiswa - Offline-First Drift Sync)
model Note {
  id        Int      @id @default(autoincrement())
  userId    String
  title     String
  body      String?  @db.Text
  synced    Boolean  @default(true)
  updatedAt BigInt   @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notes")
}

// 11. Entity TokenBlacklist (Untuk revokasi token saat logout)
model TokenBlacklist {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(500)
  createdAt DateTime @default(now())

  @@map("token_blacklist")
}
